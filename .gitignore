# Оригиналы фотографий: 332 МБ, нужны только для пересборки картинок
# локально. На хостинг не едут.
photos/

# Служебное
__pycache__/
*.pyc
.env
secret/

# Секретный адрес страницы входа задаётся переменной LOGIN_PATH,
# сама страница в репозиторий не попадает
site/login/

# Файлы, загруженные через админку: они живут на диске хостинга
site/img/upload/

# Исходные документы с данными владелицы сайта: в репозиторий
# и на хостинг не едут. Сами данные лежат в data/seller.json.
materials/

# Заказы покупателей и копии писем: это персональные данные живых людей.
# Живут на диске хостинга, в репозитории им делать нечего.
data/orders.json

# Журнал действий администратора и копии заменённых фотографий к нему:
# тоже данные с диска хостинга, а не часть кода.
data/logs.json
site/img/logs/
