# Образец. Скопируйте в .env и подставьте значения из консоли Firebase.
# Значения web-конфига не являются секретом: они всё равно уходят в браузер.
# Доступ ограничивают правила безопасности Firebase и список разрешённых доменов.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
