# Образец. Скопируйте в .env и подставьте значения из консоли Firebase.
# Значения web-конфига не являются секретом: они всё равно уходят в браузер.
# Доступ ограничивают правила безопасности Firebase и список разрешённых доменов.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Письма о заказе. Ключ берётся в resend.com -> API Keys, это настоящий секрет.
# Без него сайт работает, но письма не отправляются.
RESEND_API_KEY=
# Отправитель. Домен обязан быть подтверждён в Resend.
MAIL_FROM=cotton wool creativity <zakaz@xn-----8kchczebbr9d6ae4euc.xn--p1ai>
